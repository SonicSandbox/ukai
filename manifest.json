{
  "manifest_version": 3,
  "name": "Ukai 鵜飼 · for Surasura",
  "version": "0.2.0",
  "description": "Ukai, Surasura's watch companion: brings the subtitles and the clips of what you watch on Netflix, Disney+ and YouTube home to your local Surasura.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "alarms",
    "tabCapture",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.disneyplus.com/*",
    "*://*.youtube.com/*",
    "http://127.0.0.1:27631/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Ukai: send to Surasura",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "src/debug.js",
        "src/hook.js",
        "src/meta.js",
        "src/sites/netflix_page.js",
        "src/isolate.js",
        "src/bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "src/debug.js",
        "src/parsers.js",
        "src/sites/netflix.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.disneyplus.com/*"
      ],
      "js": [
        "src/debug.js",
        "src/hook.js",
        "src/sites/disneyplus_page.js",
        "src/isolate.js",
        "src/bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.disneyplus.com/*"
      ],
      "js": [
        "src/debug.js",
        "src/parsers.js",
        "src/sites/disneyplus.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open Ukai (also grants tab capture for the current tab)"
    }
  }
}
