{
  "manifest_version": 3,
  "name": "Surasura subtitle sender",
  "version": "0.2.0",
  "description": "Sends the subtitles of the Netflix / Disney+ video you are watching to your local Surasura app.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "alarms",
    "tabCapture",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.disneyplus.com/*",
    "*://*.youtube.com/*",
    "http://127.0.0.1:27631/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Send to Surasura",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "src/hook.js",
        "src/meta.js",
        "src/sites/netflix_page.js",
        "src/isolate.js",
        "src/bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "src/parsers.js",
        "src/sites/netflix.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.disneyplus.com/*"
      ],
      "js": [
        "src/hook.js",
        "src/sites/disneyplus_page.js",
        "src/isolate.js",
        "src/bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.disneyplus.com/*"
      ],
      "js": [
        "src/parsers.js",
        "src/sites/disneyplus.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open Surasura (also grants tab capture for the current tab)"
    }
  }
}
